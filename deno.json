{
  "tasks": {
    "dev": "deno task build && python app.py",
    "build": "deno run -A npm:vite build",
    "build:exe": "deno task build && pyinstaller transcript-search.spec --distpath build/app --workpath build/pyinstaller --noconfirm",
    "preview": "deno run -A npm:vite preview",
    "test": "python -m unittest discover -s tests"
  },
  "imports": {
    "vite": "npm:vite@^6.0.0",
    "svelte": "npm:svelte@^5.48.2",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.2.4",
    "lucide-svelte": "npm:lucide-svelte@^0.469.0"
  },
  "nodeModulesDir": "auto"
}
